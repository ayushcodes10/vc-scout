# Copy to .env and fill in. .env is gitignored, is never read into an artifact, and is
# never persisted, logged or echoed by any command.
# The pipeline reads credentials from the environment only - never from a CLI flag.

# Provider credential. Required only for a live run.
# `vc-scout demo` runs the whole pipeline offline against committed fixtures with no
# credential at all, and so does the entire test suite. `vc-scout source`, `vc-scout
# enrich`, `vc-scout recommend`, `vc-scout build-ui` and `vc-scout export-demo` never
# need one either.
ANTHROPIC_API_KEY=

# Model used for evidence extraction. Defaults to claude-opus-5 when unset.
LLM_MODEL=claude-opus-5

# Optional overrides.
VC_SCOUT_PROVIDER=anthropic
VC_SCOUT_RUNS_ROOT=outputs/runs

# Nothing below is required. The pipeline reads no other environment variable, and no
# variable of any kind is written into an artifact, a report, a memo or the site.
