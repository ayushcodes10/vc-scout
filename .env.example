# Copy to .env and fill in. .env is gitignored, is never read into an artifact, and is
# never persisted, logged or echoed by any command.
# The pipeline reads credentials from the environment only - never from a CLI flag.

# Provider credential. Required only for live evidence extraction.
# `vc-scout source`, `vc-scout enrich`, `--provider fake` and the entire test suite all
# run without it.
ANTHROPIC_API_KEY=

# Model used for evidence extraction. Defaults to claude-opus-5 when unset.
LLM_MODEL=claude-opus-5

# Optional overrides.
VC_SCOUT_PROVIDER=anthropic
VC_SCOUT_RUNS_ROOT=outputs/runs
