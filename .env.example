# Copy to .env and fill in. .env is gitignored and is never read into an artifact.
# The pipeline reads credentials from the environment only - never from a CLI flag.

# Provider credential. Required only for live runs; `vc-scout demo` and the test
# suite both run without it.
ANTHROPIC_API_KEY=

# Optional overrides.
VC_SCOUT_PROVIDER=anthropic
VC_SCOUT_MODEL=claude-sonnet-5
VC_SCOUT_RUNS_ROOT=outputs/runs
