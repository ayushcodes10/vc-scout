# OS
.DS_Store

# Editors
.vscode/
.idea/

# Env / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Logs
*.log
logs/

# Pipeline output. The committed demo run is the one exception: it lets a reviewer
# read memos and browse the site without an API key or network access.
outputs/runs/*
!outputs/runs/demo/

# The reviewer-ready export is meant to be committed: it is what someone reads before
# running anything. `vc-scout export-demo` writes it, and it contains no raw page bodies,
# no credentials and no absolute paths.
!demo/
